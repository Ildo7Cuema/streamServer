# =============================================================================
# StreamServer — InterServer VPS (produção SaaS)
# Copiar para `.env` na raiz do repo na VPS:
#   cp .env.interserver.example .env
# Guia: infrastructure/icecast/INTERSERVER.md
# =============================================================================

NODE_ENV=production
APP_PORT=3000

# Preferir domínio em produção (sem http://)
PUBLIC_HOST=radio.teuempresa.com

# Site público (mesmo Nginx). Em produção usa HTTPS.
APP_URL=https://radio.teuempresa.com
PUBLIC_STREAM_URL=https://radio.teuempresa.com
CORS_ORIGINS=https://radio.teuempresa.com

# SaaS: em produção NÃO actives auto-subscribe (utilizadores activam plano)
DEV_AUTO_SUBSCRIBE=false

# Icecast — BUTT liga a PUBLIC_ICECAST_HOST:8000 (SSL Off no BUTT)
ICECAST_DISABLED=false
PUBLIC_ICECAST_HOST=radio.teuempresa.com
ICECAST_HOST=icecast
ICECAST_PORT=8000
ICECAST_ADMIN_USER=admin
ICECAST_ADMIN_PASSWORD=CHANGE_ME_ADMIN
ICECAST_SOURCE_PASSWORD=CHANGE_ME_SOURCE
ICECAST_RELAY_PASSWORD=CHANGE_ME_RELAY

# Postgres (container do compose)
POSTGRES_DB=streamserver
POSTGRES_USER=streamadmin
POSTGRES_PASSWORD=CHANGE_ME_DB_PASSWORD
DATABASE_URL=

# Redis
REDIS_DISABLED=false
REDIS_PASSWORD=CHANGE_ME_REDIS

# Auth JWT
JWT_SECRET=CHANGE_ME_JWT_LONG_RANDOM
JWT_EXPIRES_IN=24h

# Não é necessário para auth Icecast (callback interno)
# INTERNAL_API_KEY=
