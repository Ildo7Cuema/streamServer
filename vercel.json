{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "version": 2,
  "name": "streamserver",
  "installCommand": "npm install",
  "buildCommand": "cd frontend && node scripts/sync-vercel-rewrites.mjs && npm run build",
  "outputDirectory": "frontend/dist",
  "framework": null,
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": "http://SEU_IP_INTERSERVER/api/$1"
    },
    {
      "source": "/ws",
      "destination": "http://SEU_IP_INTERSERVER/ws"
    },
    {
      "source": "/stream/(.*)",
      "destination": "http://SEU_IP_INTERSERVER/stream/$1"
    },
    {
      "source": "/((?!assets/).*)",
      "destination": "/index.html"
    }
  ],
  "headers": [
    {
      "source": "/assets/(.*)",
      "headers": [{ "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }]
    }
  ]
}
