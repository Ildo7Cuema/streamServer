# Copiar para frontend/.env – usado pelo Vite em dev

# Local: proxy Vite para o backend (pode omitir se usares o default 127.0.0.1:3000)
# VITE_BACKEND_URL=http://127.0.0.1:3000

# InterServer — frontend na mesma VPS via Nginx: NÃO defines VITE_BACKEND_URL
# (o browser usa /api no mesmo host).
#
# Vercel → backend na InterServer:
#   VITE_BACKEND_URL=http://SEU_IP_INTERSERVER
#   (ou https://api.teudominio.com com TLS)
#
# Na VPS (.env): PUBLIC_ICECAST_HOST=SEU_IP  ICECAST_DISABLED=false
# Guia: infrastructure/icecast/INTERSERVER.md

# Multicaixa Express — número mostrado no modal de pagamento
VITE_PAYMENT_EXPRESS_PHONE=921923232
# WhatsApp para envio de comprovativos (mesmo número por defeito)
VITE_PAYMENT_WHATSAPP_PHONE=244921923232

# Supabase no browser (opcional – @supabase/supabase-js)
VITE_SUPABASE_URL=https://YOUR_REF.supabase.co
VITE_SUPABASE_ANON_KEY=
