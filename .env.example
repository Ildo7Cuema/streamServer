# =============================================================================
# StreamServer – copiar para `.env` na RAIZ do repositório
# =============================================================================
# O backend carrega: (1) este `.env` na raiz (2) depois `backend/.env` se existir
#
# Perfil A — Base de dados só Supabase (recomendado sem Docker local):
#   DATABASE_URL=(URI do Supabase, porta 5432 ou session pooler)
#   REDIS_DISABLED=true
#   ICECAST_DISABLED=true
#   → npm run install:all → npm run seed → npm run dev:backend (+ dev:frontend)
#
# Perfil B — Docker stack completo (Postgres+Redis+Icecast no compose):
#   Não uses DATABASE_URL (ou deixa vazio). docker compose up -d
#
# Arranque rápido (API + Supabase):
#   1) Supabase SQL Editor → `infrastructure/postgres/init.sql` (podes reexecutar; é idempotente)
#   2) Colar DATABASE_URL em .env

# -----------------------------------------------------------------------------
# Geral
# -----------------------------------------------------------------------------
NODE_ENV=development
APP_PORT=3000
APP_URL=http://localhost:5173
# Produção (Render): URL HTTPS do frontend na Vercel — gera links https://…/stream/…
# APP_URL=https://o-teu-app.vercel.app
# Alternativa explícita para ouvir online (se diferente do dashboard):
# PUBLIC_STREAM_URL=https://o-teu-app.vercel.app
# CORS_ORIGINS=https://o-teu-app.vercel.app,https://outro-dominio.com

# -----------------------------------------------------------------------------
# Base de dados (Supabase ou Postgres local)
# -----------------------------------------------------------------------------
# Obrigatório para Supabase: usar o pooler IPv4 (Connect → Session mode, porta 5432).
# NÃO uses db.[ref].supabase.co em redes só IPv4 — esse host é IPv6-only.
# Exemplo:
# DATABASE_URL=postgresql://postgres.[ref]:[PASSWORD]@aws-1-eu-central-1.pooler.supabase.com:5432/postgres
DATABASE_URL=

# Opcional: forçar SSL off (raro)
# DATABASE_SSL=false

# Usado só se DATABASE_URL estiver vazio (Postgres local / container)
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=streamserver
POSTGRES_USER=streamadmin
POSTGRES_PASSWORD=devpassword

# -----------------------------------------------------------------------------
# Redis (cache / stats). Em dev sem Redis:
REDIS_DISABLED=true
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=devredis

# -----------------------------------------------------------------------------
# Icecast (streaming). Em dev só API + BD:
ICECAST_DISABLED=true
ICECAST_HOST=localhost
ICECAST_PORT=8000
ICECAST_ADMIN_USER=admin
ICECAST_ADMIN_PASSWORD=adminpass
ICECAST_HOSTNAME=localhost
ICECAST_SOURCE_PASSWORD=sourcepass
ICECAST_RELAY_PASSWORD=relaypass
# Produção — host público onde o Icecast aceita ligações (BUTT / fonte).
# Na InterServer: usa o IP público da VPS (ou DNS A → esse IP). Porta TCP 8000 aberta.
# PUBLIC_ICECAST_HOST=66.45.xxx.xxx
# ICECAST_HOST=66.45.xxx.xxx   (mesmo host; backend usa para proxy /stream e admin)
# ICECAST_DISABLED=false
# Guia: infrastructure/icecast/INTERSERVER.md
# URL pública para ouvir online (fallback se APP_URL não estiver definido):
# PUBLIC_STREAM_URL=https://o-teu-app.vercel.app

# SaaS / Assinaturas
# DEV_AUTO_SUBSCRIBE=true   # activa plano automaticamente em dev (sem Stripe)
# STRIPE_SECRET_KEY=
# STRIPE_WEBHOOK_SECRET=
# STRIPE_PUBLISHABLE_KEY=

# Pagamentos Multicaixa Express (Angola — AOA)
# PAYMENT_EXPRESS_PHONE=921923232
# PAYMENT_EXPRESS_NAME=StreamServer
# PAYMENT_NOTE=Indica o teu utilizador no assunto da transferência, se possível.
# PAYMENT_PROOFS_PATH=/tmp/streamserver-proofs

# -----------------------------------------------------------------------------
# Liquidsoap
# -----------------------------------------------------------------------------
LIQUIDSOAP_TELNET_HOST=localhost
LIQUIDSOAP_TELNET_PORT=1234

# -----------------------------------------------------------------------------
# Auth
# -----------------------------------------------------------------------------
JWT_SECRET=dev-change-me-min-32-chars-secret-key
JWT_EXPIRES_IN=24h
JWT_REFRESH_EXPIRES_IN=7d

# -----------------------------------------------------------------------------
# Supabase API (opcional – cliente REST / futuras integrações)
# -----------------------------------------------------------------------------
# Supabase API (Settings → API)
# SUPABASE_URL=https://YOUR_REF.supabase.co
# SUPABASE_ANON_KEY=
# SUPABASE_JWT_SECRET=   # Settings → API → JWT Secret (backend only)
# SUPABASE_SERVICE_ROLE_KEY=

# -----------------------------------------------------------------------------
# Armazenamento (dev local)
# -----------------------------------------------------------------------------
MEDIA_STORAGE_PATH=/tmp/streamserver-media
RECORDINGS_PATH=/tmp/streamserver-recordings

# -----------------------------------------------------------------------------
# Rate limiting (API)
# -----------------------------------------------------------------------------
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100

# -----------------------------------------------------------------------------
# Docker Compose – produção / stack completo (valores de exemplo)
# -----------------------------------------------------------------------------
# POSTGRES_PASSWORD=CHANGE_ME
# REDIS_PASSWORD=CHANGE_ME
# JWT_SECRET=CHANGE_ME_LONG_RANDOM
# APP_URL=https://radio.example.com
